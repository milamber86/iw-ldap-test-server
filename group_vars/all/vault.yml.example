---
# Ansible Vault template for IceWarp LDAP test lab secrets.
#
# Setup:
#   cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#   # edit vault.yml
#   ansible-vault encrypt group_vars/all/vault.yml
#   # optional: echo 'your-vault-password' > ../.vault-pass   (path used by deploy.sh)
#
# Do NOT commit vault.yml (gitignored). This .example file is safe to commit.

# 389 Directory Manager (cn=Directory Manager)
LDAP_DM_PASSWORD: "ChangeMe-DM-Pass1"

# IceWarp bind account (uid=iwsync,ou=services,...)
LDAP_BIND_PASSWORD: "ChangeMe-Bind-Pass1"

# Default password for fixture inetOrgPerson accounts (alice, bob, carol, dave, nomail)
# when the uid is not in LDAP_USER_PASSWORDS. Quote values that contain YAML specials.
LDAP_USER_PASSWORD: "ChangeMe-User-Pass1"

# Optional per-uid overrides (omit a uid to use LDAP_USER_PASSWORD).
# LDAP_USER_PASSWORD may be empty if every fixture uid is listed here.
# LDAP_USER_PASSWORDS:
#   alice: "Gäöüß-User-Pass1"
#   bob: "Pass!@#$%^&*()"
#   carol: "space and 'quotes'"
#   dave: "slash/backslash\\end"
#   nomail: "ChangeMe-User-Pass1"

# Optional — Ansible SSH to managed hosts (default: root + key, no become)
# ANSIBLE_SSH_USER: "root"
# ANSIBLE_SSH_PASS: ""
# ANSIBLE_BECOME_VIA: none      # none | sudo_su | su
# ANSIBLE_BECOME_PASS: ""
